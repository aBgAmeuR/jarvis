# Copy to docker/.env. Defaults are in apps/server/internal/platform/config; see docs/configuration.md.

# Required
JARVIS_PROXMOX_URL=https://pve:8006
# Mounted by compose from docker/proxmox_token
JARVIS_PROXMOX_TOKEN_FILE=/run/secrets/proxmox_token
# Address allowed to send Remote-* headers (Caddy)
JARVIS_TRUSTED_PROXY=192.168.1.113

# Optional
# JARVIS_LISTEN_ADDR=:8080
# JARVIS_PROMETHEUS_URL=http://prometheus:9090
# JARVIS_LOKI_URL=http://loki:3100
# JARVIS_TEMPO_URL=http://tempo:3200
# JARVIS_ALERTMANAGER_URL=http://alertmanager:9093
# JARVIS_PROXMOX_CA_FILE=
# JARVIS_CATALOG_PATH=/etc/jarvis/catalog.json
# JARVIS_FILES_ROOT=
# JARVIS_REQUEST_TIMEOUT=5s
# JARVIS_CACHE_TTL=2s
# JARVIS_LOG_LEVEL=info
# JARVIS_OTLP_ENDPOINT=
# JARVIS_GRAFANA_URL=
# JARVIS_GRAFANA_PROMETHEUS_UID=prometheus
# JARVIS_GRAFANA_LOKI_UID=loki
